# Trip Service environment configuration
# Copy to .env and adjust as needed.

SERVICE_NAME=trip-service
API_V1_PREFIX=/api/v1
DEBUG=true

# PostgreSQL (async driver). Database must exist before startup.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trip_service
DB_ECHO=false

# Supabase JWT verification
SUPABASE_JWT_SECRET=super-secret-dev-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_AUDIENCE=authenticated

# Set to false to require real bearer tokens. true injects a dev user.
AUTH_DISABLED=true

# CORS origins must be a JSON array.
CORS_ORIGINS=["*"]
