# ---- App ---------------------------------------------------------------------
APP_ENV=development
AI_SERVICE_PORT=8000

# ---- PostgreSQL (pgvector) ---------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=travel_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ---- Qdrant ------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true
QDRANT_HTTPS=false
QDRANT_COLLECTION_TRAVEL=travel_items
QDRANT_API_KEY=change-me

# ---- Neo4j -------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# ---- LangSmith / LangChain ---------------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-platform
LANGCHAIN_TRACING_V2=false

# ---- LLM / providers (Google Gemini) -----------------------------------------
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# ---- External APIs -----------------------------------------------------------
MAPS_API_KEY=
WEATHER_API_KEY=
TRANSPORT_API_KEY=
TOURISM_API_KEY=

# ---- Real-time data providers (free sources) ---------------------------------
# Open-Meteo (weather + geocoding) and OSM Overpass (POIs) need NO API key.
# OpenTripMap / OpenRouteService keys are optional (instant free signup).
OPENTRIPMAP_API_KEY=
OPENROUTESERVICE_API_KEY=
# Sri Lanka bounding box (south, west, north, east) for Overpass queries.
SL_BBOX_SOUTH=5.9
SL_BBOX_WEST=79.6
SL_BBOX_NORTH=9.9
SL_BBOX_EAST=81.9
